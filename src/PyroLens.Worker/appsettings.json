{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Polly": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Firms": {
    "Mode": "File",
    "Sources": [ "VIIRS_SNPP_NRT", "VIIRS_NOAA20_NRT", "VIIRS_NOAA21_NRT", "MODIS_NRT" ],
    "Area": { "West": 19.3, "South": 34.7, "East": 29.7, "North": 41.8 },
    "DayRange": 2,
    "SampleFile": "samples/firms_sample_synthetic.csv"
  },
  "Ingestion": {
    "PollInterval": "00:10:00"
  },
  "DetectionFilter": {
    "ModisConfidenceAbove": 70,
    "ViirsConfidence": [ "nominal", "high" ],
    "IndustrialConsecutiveDays": 3,
    "IndustrialRadiusMeters": 500,
    "RequireAreaOfInterest": true
  },
  "Forecast": {
    "Interval": "00:30:00",
    "InitialDelay": "00:01:00",
    "ActiveIncidentHours": 24,
    "BatchSize": 50,
    "DroughtFactor": 8,
    "FuelLoadTonnesPerHectare": 12
  },
  "Clustering": {
    "WindowHours": 24,
    "ClusterDistanceMeters": 1500,
    "AttachDistanceMeters": 2000,
    "IncidentActiveHours": 48
  }
}
